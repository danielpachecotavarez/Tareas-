Algoritmo Mensajepersonalizado 
	
	//Mensaje personalizado1-3//
	
	
	Definir n Como Entero
    Escribir "Ingrese un número (1?3):"
    Leer n
    Segun n Hacer
        1: Escribir "Mensaje uno: ¡Buen día!"
        2: Escribir "Mensaje dos: ¡Sigue aprendiendo!"
        3: Escribir "Mensaje tres: ¡Excelente trabajo!"
        De Otro Modo: Escribir "Número fuera de rango."
    FinSegun

	
	
	
	
	
	
	
	
	
	
FinAlgoritmo
	
	
	
	
	
	
	
	
	