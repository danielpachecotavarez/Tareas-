Algoritmo suma_hasta_0
	//Sumar números hasta que se ingrese//
    Definir n, suma Como Entero
    suma <- 0
    Repetir
        Escribir "Ingrese un número (0 para salir):"
        Leer n
        suma <- suma + n
    Hasta Que n = 0
    Escribir "La suma total es: ", suma
	
	
	
	
	
	
	
	
	
FinAlgoritmo
