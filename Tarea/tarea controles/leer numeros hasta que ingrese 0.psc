Algoritmo contarhasta0
	
	//leer numero hasta que ingrese 0//
	Definir n, contador Como Entero
    contador <- 0
    Escribir "Ingrese números (0 para terminar):"
    Leer n
    Mientras n <> 0 Hacer
        contador <- contador + 1
        Leer n
    FinMientras
    Escribir "Ingresó ", contador, " números."	
	
	
	
	
	
	
	
	
	
	
FinAlgoritmo
