Algoritmo contar_postivo
	
	//Contar números positivos hasta que se ingrese uno negativo//
	
	Definir n, contador Como Entero
    contador <- 0
    Escribir "Ingrese números (negativo para terminar):"
    Leer n
    Mientras n >= 0 Hacer
        contador <- contador + 1
        Leer n
    FinMientras
    Escribir "Cantidad de números positivos: ", contador
	
	
	
	
	
	
	
	
	
	
FinAlgoritmo
