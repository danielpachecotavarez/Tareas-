Algoritmo factorial
//Calcular factorial de un número//	
	
	Definir n, i, fact Como Entero
    fact <- 1
    Escribir "Ingrese un número:"
    Leer n
    i <- 1
    Repetir
        fact <- fact * i
        i <- i + 1
    Hasta Que i > n
    Escribir "El factorial es: ", fact	
	
	
	
	
	
FinAlgoritmo
